#include <windows.h>
1 RT_MANIFEST "alarm.manifest"
101 ICON "../assets/alarm.ico"
1 VERSIONINFO
FILEVERSION 0,6,1,0
PRODUCTVERSION 0,6,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Ibrahim Bouillet"
      VALUE "FileDescription", "ALARM"
      VALUE "FileVersion", "0.6.1"
      VALUE "InternalName", "ALARM"
      VALUE "LegalCopyright", "Copyright (c) 2026 Ibrahim Bouillet"
      VALUE "OriginalFilename", "ALARM.exe"
      VALUE "ProductName", "ALARM"
      VALUE "ProductVersion", "0.6.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
