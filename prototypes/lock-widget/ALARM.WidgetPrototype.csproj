<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Ibrahim Bouillet</Authors>
    <Copyright>Copyright (c) 2026 Ibrahim Bouillet.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AssemblyName>ALARM.WidgetPrototype</AssemblyName>
    <AssemblyName Condition="'$(AlarmWidgetCandidate)'=='true'">ALARM.WidgetProvider</AssemblyName>
    <DefineConstants Condition="'$(AlarmWidgetCandidate)'=='true'">$(DefineConstants);ALARM_WIDGET_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Microsoft-Samples-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
